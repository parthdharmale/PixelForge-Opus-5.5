{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pixelforge/core": ["packages/core/src/index.ts"],
      "@pixelforge/codegen": ["packages/codegen/src/index.ts"],
      "@pixelforge/agent": ["packages/agent/src/index.ts"],
      "@pixelforge/vite-plugin": ["packages/vite-plugin/src/index.ts"]
    }
  }
}
